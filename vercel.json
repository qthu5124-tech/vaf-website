{
	"headers": [
		{
			"source": "/images/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/(.*).(css|js|svg|xml|txt)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=604800, stale-while-revalidate=86400"
				}
			]
		},
		{
			"source": "/partials/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=604800, stale-while-revalidate=86400"
				}
			]
		}
	],
	"redirects": [
		{
			"source": "/post/:path*",
			"destination": "/",
			"permanent": true
		}
	],
	"rewrites": [
		{
			"source": "/(.*)",
			"destination": "/index.html"
		}
	]
}
