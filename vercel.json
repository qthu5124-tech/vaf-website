{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/PROFILE-VAF.pdf",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"VAF-Company-Profile.pdf\""
        }
      ]
    },
    {
      "source": "/images/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		},
		{
			"source": "/(.*).(css|js|svg|xml|txt)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=604800, stale-while-revalidate=86400"
				}
			]
		},
		{
			"source": "/partials/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=604800, stale-while-revalidate=86400"
				}
			]
		}
	],
	"redirects": [
		{
			"source": "/:path*",
			"has": [{ "type": "host", "value": "vi.vietfil.com" }],
			"destination": "https://www.vietfil.com/:path*",
			"permanent": true
		},
		{ "source": "/vi", "destination": "/", "permanent": true },
		{ "source": "/vi/:path*", "destination": "/:path*", "permanent": true },
		{ "source": "/products/air-shower", "destination": "/product/air-shower", "permanent": true },
		{ "source": "/products/blower-filter-init-bfu-thiet-bi-phong-sach", "destination": "/product/bfu", "permanent": true },
		{ "source": "/products/loc-tho-pre-fine-v-ra", "destination": "/product/v-ra", "permanent": true },
		{ "source": "/air-filter-supply", "destination": "/projects", "permanent": true },
		{ "source": "/blog/categories/:path*", "destination": "/news", "permanent": true },
		{ "source": "/amp/:path*", "destination": "/news", "permanent": true },
		{ "source": "/post/loc-khi-viet-tuyen-dung-ke-toan", "destination": "/tuyen-dung", "permanent": true },
		{ "source": "/tuyen-dung/nhan-vien-kinh-doanh-ky-thuat", "destination": "/tuyen-dung", "permanent": true },
		{ "source": "/tuyen-dung/ky-su-hvac", "destination": "/tuyen-dung", "permanent": true },
		{ "source": "/tuyen-dung/nhan-vien-san-xuat", "destination": "/tuyen-dung", "permanent": true },
		{ "source": "/tuyen-dung/ky-thuat-kiem-tra-hepa", "destination": "/tuyen-dung/nhan-vien-qc-phong-sach", "permanent": true },
		{ "source": "/tuyen-dung/thuc-tap-sinh-marketing", "destination": "/tuyen-dung", "permanent": true },
		{ "source": "/en/tuyen-dung/nhan-vien-kinh-doanh-ky-thuat", "destination": "/en/tuyen-dung", "permanent": true },
		{ "source": "/en/tuyen-dung/ky-su-hvac", "destination": "/en/tuyen-dung", "permanent": true },
		{ "source": "/en/tuyen-dung/nhan-vien-san-xuat", "destination": "/en/tuyen-dung", "permanent": true },
		{ "source": "/en/tuyen-dung/ky-thuat-kiem-tra-hepa", "destination": "/en/tuyen-dung/nhan-vien-qc-phong-sach", "permanent": true },
		{ "source": "/en/tuyen-dung/thuc-tap-sinh-marketing", "destination": "/en/tuyen-dung", "permanent": true },
		{ "source": "/projects-all", "destination": "/projects", "permanent": true },
		{ "source": "/en/projects", "destination": "/projects", "permanent": true },
		{ "source": "/en/projects-all", "destination": "/projects", "permanent": true },
		{ "source": "/en/project/:id", "destination": "/project/:id", "permanent": true },
		{ "source": "/blog", "destination": "/news", "permanent": true },
		{ "source": "/blog/:path*", "destination": "/news", "permanent": true },
		{ "source": "/category/:path*", "destination": "/products", "permanent": true },
		{ "source": "/fine-filters", "destination": "/products", "permanent": true },
		{ "source": "/pre-filters", "destination": "/products", "permanent": true },
